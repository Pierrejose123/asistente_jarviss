# Copie este archivo como .env y rellene los valores. El .env NUNCA se comparte ni se sube a GitHub.

# --- Usted ---
NOMBRE_USUARIO=Su nombre
# A qué se dedica, en pocas palabras (la IA lo usa para hablarle mejor). Ej.: estudiante de ingeniería
PERFIL_USUARIO=
# Su zona horaria (lista: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
ZONA_HORARIA=America/Guayaquil

# --- Telegram (obligatorio) ---
# Cree un bot con @BotFather y pegue aquí su token. Luego ejecute modulos\telegram\obtener_user_id.py
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# --- Moodle (opcional) ---
# Dirección de su aula virtual, ej. https://campus.su-instituto.edu
MOODLE_SITIO=
# Los llenan solos modulos\estudio\conectar_moodle.py o conectar_moodle_navegador.py
MOODLE_TOKEN=
MOODLE_ICAL_URL=
